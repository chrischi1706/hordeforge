<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Faehrt die NUnit-Tests aus Assets/HordeForge/Tests/EditMode ausserhalb von Unity.
    Es sind dieselben Dateien, die der Unity Test Runner spaeter im Editor ausfuehrt.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../Assets/HordeForge/Tests/EditMode/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../HordeForge.Core.Standalone/HordeForge.Core.Standalone.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>

</Project>
