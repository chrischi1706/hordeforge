<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Laesst die Simulation ohne Unity durchlaufen und protokolliert, was passiert.

    Zweck ist Balancing: Halten die Produktionsketten mit? Wachsen die Wellen
    angemessen? Ueberlebt eine vernuenftig gespielte Siedlung lange genug?
    Der Ablauf wird von einem einfachen Bot gespielt, der die Regeln des Spiels
    ueber dieselben Schnittstellen bedient wie die Oberflaeche.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <AssemblyName>HordeForge.Playthrough</AssemblyName>
    <RootNamespace>HordeForge.Playthrough</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../HordeForge.Core.Standalone/HordeForge.Core.Standalone.csproj" />
  </ItemGroup>

</Project>
